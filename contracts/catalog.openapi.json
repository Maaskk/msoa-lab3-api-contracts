{
  "openapi": "3.0.3",
  "info": {
    "title": "LAB3 Catalog",
    "version": "2.0.0",
    "description": "Contrat du TP. Les prix historiques et les commandes restent en MAD. Les paiements sont simules. Responsable attribue : Sekkat Israa"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8082"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "catalog_get__health",
        "summary": "Verifier que le processus repond",
        "description": "Verifier que le processus repond",
        "security": [],
        "responses": {
          "200": {
            "description": "Succes. 200 est conserve pour les contrats herites du LAB2.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identifiant de correlation"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "catalog_get__products",
        "summary": "Lister les produits avec prix numerique en MAD",
        "description": "Lister les produits avec prix numerique en MAD",
        "security": [],
        "responses": {
          "200": {
            "description": "Succes. 200 est conserve pour les contrats herites du LAB2.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identifiant de correlation"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductV1"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/products/{productId}": {
      "get": {
        "operationId": "catalog_get__products_productId",
        "summary": "Lire un produit historique en MAD",
        "description": "Lire un produit historique en MAD",
        "security": [],
        "responses": {
          "200": {
            "description": "Succes. 200 est conserve pour les contrats herites du LAB2.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identifiant de correlation"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductV1"
                }
              }
            }
          },
          "404": {
            "description": "Ressource inexistante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Identifiant de la ressource"
          }
        ]
      }
    },
    "/api/v2/products": {
      "get": {
        "operationId": "catalog_get__api_v2_products",
        "summary": "Lister les produits avec price.amount et price.currency",
        "description": "Lister les produits avec price.amount et price.currency",
        "security": [],
        "responses": {
          "200": {
            "description": "Succes. 200 est conserve pour les contrats herites du LAB2.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identifiant de correlation"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductV2"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entree ou JSON invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflit metier ou prix indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Devise de la liste de prix fixe de demonstration. Aucun taux de change temps reel.",
            "schema": {
              "type": "string",
              "enum": [
                "MAD",
                "EUR",
                "USD"
              ],
              "default": "MAD"
            }
          }
        ]
      }
    },
    "/api/v2/products/{productId}": {
      "get": {
        "operationId": "catalog_get__api_v2_products_productId",
        "summary": "Lire un produit avec prix structure",
        "description": "Lire un produit avec prix structure",
        "security": [],
        "responses": {
          "200": {
            "description": "Succes. 200 est conserve pour les contrats herites du LAB2.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Identifiant de correlation"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductV2"
                }
              }
            }
          },
          "400": {
            "description": "Entree ou JSON invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Ressource inexistante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflit metier ou prix indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Devise de la liste de prix fixe de demonstration. Aucun taux de change temps reel.",
            "schema": {
              "type": "string",
              "enum": [
                "MAD",
                "EUR",
                "USD"
              ],
              "default": "MAD"
            }
          },
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Identifiant de la ressource"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Session opaque renvoyee par Auth.login"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Key",
        "description": "Cle commune uniquement entre services"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "message",
          "requestId"
        ]
      },
      "Success": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "success"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "UP"
            ]
          }
        },
        "required": [
          "service",
          "status"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "SYSTEM"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "Register": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "token"
        ]
      },
      "Money": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "MAD",
              "EUR",
              "USD"
            ]
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "additionalProperties": false
      },
      "Line": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "address",
          "city"
        ]
      },
      "Stock": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "productId",
          "stock"
        ]
      },
      "Availability": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "available"
        ]
      },
      "StockRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          },
          "reservationId": {
            "type": "string",
            "maxLength": 149
          }
        },
        "required": [
          "items"
        ]
      },
      "Release": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          },
          "reservationId": {
            "type": "string",
            "maxLength": 149
          }
        },
        "required": [
          "items",
          "reservationId"
        ]
      },
      "ReservationResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "reservationId": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "reservationId"
        ]
      },
      "OrderRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          }
        },
        "required": [
          "userId",
          "customer",
          "items"
        ]
      },
      "PricedLine": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "productId",
          "quantity",
          "name",
          "price"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PricedLine"
            }
          },
          "total": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATING",
              "REJECTED",
              "PENDING_PAYMENT",
              "PAID",
              "CANCELLING",
              "CANCELLED",
              "SHIPPED",
              "DELIVERED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "customer",
          "items",
          "total",
          "status",
          "createdAt"
        ]
      },
      "OrderStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "CREATING",
              "REJECTED",
              "PENDING_PAYMENT",
              "PAID",
              "CANCELLING",
              "CANCELLED",
              "SHIPPED",
              "DELIVERED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "PaymentRequest": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "CARD",
              "CASH"
            ]
          }
        },
        "required": [
          "orderId",
          "method"
        ]
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "method": {
            "type": "string",
            "enum": [
              "CARD",
              "CASH"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "REFUNDED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "orderId",
          "userId",
          "amount",
          "method",
          "status",
          "createdAt"
        ]
      },
      "ShipmentRequest": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/Customer"
          }
        },
        "required": [
          "orderId",
          "address"
        ]
      },
      "Shipment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/Customer"
          },
          "trackingNumber": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PREPARING",
              "SHIPPED",
              "IN_TRANSIT",
              "DELIVERED",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "orderId",
          "userId",
          "address",
          "trackingNumber",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "ShipmentStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "SHIPPED",
              "IN_TRANSIT",
              "DELIVERED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "OrderAction": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "PAY"
                ]
              },
              "method": {
                "type": "string",
                "enum": [
                  "CARD",
                  "CASH"
                ]
              }
            },
            "required": [
              "action",
              "method"
            ]
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "PREPARE",
                  "SHIP",
                  "TRANSIT",
                  "DELIVER",
                  "CANCEL"
                ]
              }
            },
            "required": [
              "action"
            ]
          }
        ]
      },
      "Capture": {
        "type": "object",
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "method": {
            "type": "string",
            "enum": [
              "CARD",
              "CASH"
            ]
          }
        },
        "required": [
          "order",
          "method"
        ]
      },
      "Prepare": {
        "type": "object",
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          }
        },
        "required": [
          "order"
        ]
      },
      "Advance": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "SHIPPED",
              "IN_TRANSIT",
              "DELIVERED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ProductV1": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "price",
          "category",
          "image",
          "description"
        ]
      },
      "ProductV2": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "id",
          "name",
          "price",
          "category",
          "image",
          "description"
        ]
      }
    }
  }
}
